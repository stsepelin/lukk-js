{
  "$schema": "../../node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "pnpm",
  "testRunner": "vitest",
  "plugins": [
    "@stryker-mutator/vitest-runner"
  ],
  "reporters": [
    "clear-text",
    "progress"
  ],
  "coverageAnalysis": "perTest",
  "mutate": [
    "src/**/*.ts",
    "!src/**/*.d.ts"
  ],
  "clearTextReporter": {
    "maxTestsToLog": 0
  },
  "vitest": {
    "configFile": "vitest.mutation.config.ts"
  },
  "thresholds": {
    "high": 95,
    "low": 90,
    "break": 85
  }
}
