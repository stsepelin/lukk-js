{
  "name": "lukk-js",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "JavaScript/TypeScript clients for lukk (first-party Laravel JWT auth) + an auth-aware client for your own Laravel API",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" build",
    "test": "pnpm --filter lukk-core build && pnpm -r --filter \"./packages/*\" test",
    "test:conformance": "pnpm -r --filter \"./packages/*\" test:conformance",
    "typecheck": "pnpm -r --filter \"./packages/*\" typecheck",
    "lint": "eslint .",
    "dev": "pnpm --filter lukk-nuxt dev",
    "changeset": "changeset",
    "release": "pnpm build && changeset publish",
    "test:mutation": "pnpm -r test:mutation"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@nuxt/eslint-config": "^1.17.0",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "eslint": "^10.13.0",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "overrides": {
      "esbuild": ">=0.25.0",
      "qs@<6.16.0": "^6.16.0"
    }
  }
}
